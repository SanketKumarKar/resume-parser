# Resume Extractor Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# OPTION 1: Google Gemini API (Cloud-based, requires API key)
# Get your free API key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# ==============================================================================
# OPTION 2: Local Ollama (Free, runs on your machine)
# Install from: https://ollama.com
# Used automatically when GEMINI_API_KEY is empty or missing
# ==============================================================================
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4

# Server Configuration
PORT=5000
